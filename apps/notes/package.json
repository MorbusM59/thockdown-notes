{
  "name": "thockdown-notes",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:browser": "vite --mode browser",
    "build": "tsc && vite build && electron-builder && electron-builder --config electron-builder.portable.json5",
    "preview": "vite preview",
    "adventure:sim": "vite-node scripts/adventure/simulate.ts --",
    "adventure:balance": "vite-node scripts/adventure/balance.ts --",
    "adventure:play": "xvfb-run -a node scripts/adventure/playthrough.mjs",
    "perf:input-lag": "node scripts/perf/measureInputLag.mjs",
    "perf:input-lag:electron": "xvfb-run -a node scripts/perf/measureInputLagElectron.mjs",
    "perf:input-lag:electron:packaged": "xvfb-run -a node scripts/perf/measureInputLagElectronPackaged.mjs",
    "perf:first-open": "xvfb-run -a node scripts/perf/measureLargeNoteFirstOpen.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "^6.43.7",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "better-sqlite3": "13.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/better-sqlite3": "^7.6.12",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
