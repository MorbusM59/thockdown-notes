<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Launch order (see MainActivity): the system splash, launch_background
      alone, covers the screen while the process starts. The app's first frame
      is the launch overlay, launch_image centred on the same colour, which
      covers the whole screen, system bars included, until the page reports
      that it shows the state it will keep. The overlay then fades, so the
      reader sees one field, then the image on it, then the finished page.
    -->

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The theme the activity runs in (BridgeActivity sets it by this name).
         The window is the same field as the splash, so whatever shows through
         before the WebView paints, or behind the system bars on a WebView
         too old to draw under them, matches what came before it. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>

    <!-- The launch theme (AndroidManifest.xml). No icon: see
         launch_icon_none.xml. Theme.SplashScreen's default would be the
         platform's generic icon, so the empty one is named explicitly. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/launch_icon_none</item>
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
