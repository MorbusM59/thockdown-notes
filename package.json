{
  "name": "thockdown",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w thockdown-notes",
    "dev:browser": "npm run dev:browser -w thockdown-notes",
    "build": "npm run build -w thockdown-notes",
    "release": "node scripts/release.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "land": "node scripts/land.mjs",
    "adventure:sim": "npm run adventure:sim -w thockdown-notes --",
    "adventure:balance": "npm run adventure:balance -w thockdown-notes --",
    "adventure:play": "npm run adventure:play -w thockdown-notes --",
    "perf:input-lag": "npm run perf:input-lag -w thockdown-notes --",
    "perf:input-lag:electron": "npm run perf:input-lag:electron -w thockdown-notes --",
    "perf:input-lag:electron:packaged": "npm run perf:input-lag:electron:packaged -w thockdown-notes --",
    "perf:first-open": "npm run perf:first-open -w thockdown-notes --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "postcss": "^8.5.14",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
