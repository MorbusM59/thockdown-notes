{
  "name": "thockdownnotes",
  "private": true,
  "version": "0.5.7",
  "type": "module",
  "scripts": {
    "predev": "node scripts/killStrayElectronDev.mjs && electron-rebuild -f -w better-sqlite3",
    "dev": "vite",
    "dev:browser": "vite --mode browser",
    "build": "tsc && vite build && electron-builder && electron-builder --config electron-builder.portable.json5",
    "release": "node scripts/release.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "pretest": "node scripts/killStrayElectronDev.mjs && npm rebuild better-sqlite3",
    "test": "vitest run",
    "perf:input-lag": "node scripts/perf/measureInputLag.mjs",
    "perf:input-lag:electron": "xvfb-run -a node scripts/perf/measureInputLagElectron.mjs",
    "perf:input-lag:electron:packaged": "xvfb-run -a node scripts/perf/measureInputLagElectronPackaged.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "^6.43.7",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@tanstack/react-virtual": "^3.14.8",
    "better-sqlite3": "^11.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@tailwindcss/vite": "^4.1.17",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.0",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9"
  },
  "main": "dist-electron/main.js"
}
